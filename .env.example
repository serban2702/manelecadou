# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=manelecadou
POSTGRES_PASSWORD=manelecadou
POSTGRES_DB=manelecadou

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# API
API_PORT=3000
NODE_ENV=development
APP_URL=http://localhost:1500
ADMIN_URL=http://localhost:1505
API_URL=http://localhost:1501

# Comma-separated emails care primesc role=admin la login
ADMIN_EMAILS=serban2702@gmail.com

# JWT + magic link
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
MAGIC_LINK_TTL_MIN=15

# Mail provider — alege smtp sau mailgun
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@manelecadou.ro
MAIL_FROM_NAME=Manele Cadou

# SMTP (folosit dacă MAIL_PROVIDER=smtp). Lasă gol = log la consolă.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# Mailgun (folosit dacă MAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=
MAILGUN_REGION=us
MAILGUN_FROM_EMAIL=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Suno (mock | real)
SUNO_PROVIDER=mock
SUNO_API_BASE_URL=
SUNO_API_KEY=

# Stripe (lasă gol = payments dezactivate)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (lasă gol = mock writer/critic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenReplay self-hosted (build-time, propagat în web prin docker-compose.prod.yml).
# Project key din dashboard OpenReplay (Preferences → Projects).
# Lăsat gol = tracker no-op.
NEXT_PUBLIC_OPENREPLAY_PROJECT_KEY=
NEXT_PUBLIC_OPENREPLAY_INGEST_POINT=https://openreplay.manelecadou.ro/ingest
