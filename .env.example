# ---------------------------------------------------------------------------
# Exemplu de configurare. Copiază în `.env` și completează.
# În producție fișierul stă la `/home/manele/.env` (chmod 600) și NU e commit-uit.
# Cheile marcate „din admin" se pot seta și din /settings (DB, criptate) —
# valoarea din DB are prioritate față de env.
# ---------------------------------------------------------------------------

# Postgres
# Dev: `postgres`, serviciul din docker-compose.yml.
# Coolify: UUID-ul resursei de bază de date (hostname-ul intern e chiar UUID-ul;
# îl vezi în „Postgres URL (internal)" pe pagina resursei).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=manelecadou
POSTGRES_PASSWORD=manelecadou
POSTGRES_DB=manelecadou
# `false` oprește alinierea automată a schemei de către TypeORM (vezi CLAUDE.md §6.2)
DB_SYNCHRONIZE=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# API
API_PORT=3000
NODE_ENV=development
APP_URL=http://localhost:1500
ADMIN_URL=http://localhost:1505
API_URL=http://localhost:1501
DEFAULT_SITE_DOMAIN=
# Câte reverse proxy-uri stau în fața API-ului:
#   1 = Caddy direct (stack-ul vechi de pe Ionos)
#   2 = Traefik (Coolify) → router intern (stack-ul nou)
# Greșit = req.ip devine IP-ul proxy-ului: throttler global + IP eronat în analytics.
TRUST_PROXY_HOPS=1

# Comma-separated emails care primesc role=admin la login
ADMIN_EMAILS=

# JWT + magic link
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
MAGIC_LINK_TTL_MIN=15
# Criptarea setărilor din DB și a credențialelor de mail. NU sunt recuperabile.
SETTINGS_ENCRYPTION_KEY=
MAIL_CRED_KEY=

# ---------------------------------------------------------------------------
# Fișiere: disc local sau Cloudflare R2
# ---------------------------------------------------------------------------
# disk = volumul containerului; r2 = Cloudflare R2 (cu cache local pentru ffmpeg).
# DB-ul păstrează path-uri /uploads/... în ambele cazuri.
STORAGE_DRIVER=disk
UPLOADS_DIR=

# DOUĂ BUCKETURI: unul de producție, altul de dev. Nu le amesteca niciodată —
# ștergerea unei generări cheamă `storage.delete`, care șterge din bucket.
#
# De unde se citește configul R2:
#   auto (implicit) = din env în afara producției, din admin → Setări în producție
#   db              = doar din admin (env doar ca rezervă)
#   env             = doar din env, baza e ignorată complet
# `auto` există pentru că pe dev lucrăm cu un dump al bazei de producție, iar
# dump-ul aduce cheile R2 REALE în `app_settings`. Fără el, dev-ul s-ar lega
# singur la bucketul de producție și ar putea șterge fișierele clienților.
STORAGE_CONFIG_SOURCE=auto

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Pe dev pune AICI bucketul de dev (ex. manelecadou-dev). În producție,
# bucketul de producție se pune în admin → Setări → Chei → Cloudflare R2.
R2_BUCKET=
# Gol = endpoint-ul se derivă din R2_ACCOUNT_ID
R2_ENDPOINT=
# Domeniu public pe bucket (ex. https://files.manelecadou.ro).
# OBLIGATORIU în producție cu r2: fără el /uploads se servește prin API și
# seek-ul în player e limitat.
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_PROVIDER=powermail
MAIL_FROM=no-reply@manelecadou.ro
MAIL_FROM_NAME=Manele Cadou

# PowerMail (dacă MAIL_PROVIDER=powermail) — https://api.powermail.wingo.ro
# O singură cheie de proiect pentru toate site-urile; identitatea se alege prin From.
# În producție cheia stă în admin /settings (criptată), env-ul e doar rezervă.
# Lasă gol în dev = log la consolă, nu se trimite nimic.
POWERMAIL_API_KEY=
POWERMAIL_API_URL=
# Categoriile de dezabonare, create în panou. Cea tranzacțională trebuie bifată
# „tranzacțională" acolo — altfel un „Unsubscribe" dat pe un mail de recuperare
# taie și magic link-ul, și livrarea melodiei.
POWERMAIL_UNSUBSCRIBE_GROUP=marketing
POWERMAIL_TRANSACTIONAL_GROUP=tranzactionale

# SMTP (dacă MAIL_PROVIDER=smtp). Lasă gol = log la consolă.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# ---------------------------------------------------------------------------
# Motoare audio
# ---------------------------------------------------------------------------
# Suno (mock | real)
SUNO_PROVIDER=mock
SUNO_API_BASE_URL=https://api.sunoapi.org
SUNO_API_KEY=
SUNO_MODEL=V4_5
SUNO_CREDIT_MONITOR_ENABLED=
SUNO_CREDIT_ALERT_THRESHOLD=

# Google Lyria — motor alternativ, se alege per interfață din admin.
# Fără cheie, generările pe motorul Google eșuează imediat (fără reîncercări).
GEMINI_API_KEY=
LYRIA_MODEL=

# ---------------------------------------------------------------------------
# Plăți
# ---------------------------------------------------------------------------
# Un singur cont Stripe pentru toate site-urile; webhook unic.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FULL_RON=

# ---------------------------------------------------------------------------
# OpenAI + chat AI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_AUTOREPLY_MODEL=
AI_CHAT_MODEL=
AI_CHAT_TEMPERATURE=
AI_CHAT_SYSTEM_PROMPT=
AI_CHAT_MODE_DEFAULT=manual
AI_CHAT_REQUIRE_APPROVAL_FOR_PAYMENT=true
AI_CHAT_REQUIRE_APPROVAL_FOR_GENERATION=true
AI_CHAT_LEARN_NIGHTLY=false

# Web Push pentru admin (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# Analytics, alerte, media
# ---------------------------------------------------------------------------
GA4_API_SECRET=
META_CAPI_TOKEN=
# Cât timp e setat, evenimentele CAPI merg în „Test events", nu în producție.
META_CAPI_TEST_EVENT_CODE=
SENTRY_DSN=
# Alerte push către owner (monitor credite Suno)
WINGO_API_KEY=
WINGO_NOTIFY_URL=
# Microserviciu media (ffmpeg/resvg pe Hetzner). Gol = randare locală.
MEDIA_SERVICE_URL=
MEDIA_SERVICE_TOKEN=
# Secret pentru invalidarea cache-ului Next.js din API
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Terminal ops (CLAUDE.md §17) — opțional
# ---------------------------------------------------------------------------
OPS_TERMINAL_CREDENTIAL=
OPS_DB_PASSWORD=
OPS_ADMIN_USER_ID=

# ---------------------------------------------------------------------------
# Build-time (Next.js) — schimbarea lor cere REBUILD, nu doar restart
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_DEFAULT_LOCALE=ro
NEXT_PUBLIC_SHOW_LANG_SWITCHER=false
# OpenReplay self-hosted (Hetzner). Gol = tracker no-op.
NEXT_PUBLIC_OPENREPLAY_PROJECT_KEY=
NEXT_PUBLIC_OPENREPLAY_INGEST_POINT=https://openreplay.manelecadou.ro/ingest

# ---------------------------------------------------------------------------
# Stack-ul nou (docker-compose.coolify.yml)
# ---------------------------------------------------------------------------
# Domeniile se pun în Coolify, pe serviciul `router`. Nimic de setat aici.
# Directorul montat în containerul ops. Sub Coolify: /data/coolify/applications/<uuid>
OPS_WORKSPACE_DIR=
