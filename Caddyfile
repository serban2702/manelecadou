# Caddyfile pentru deploy multi-site cu auto-management de domenii
# API este expus same-origin pe /api/* (NestJS folosește setGlobalPrefix('api'))
# Vezi MULTISITE_DEPLOY.md pentru context.

{
    email admin@manelecadou.ro

    on_demand_tls {
        ask http://api:3000/api/internal/caddy/ask
    }

    storage file_system /data/caddy
}

# === Snippet-uri reutilizabile ===

(api_routes) {
    @api path /api/* /socket.io/* /health /uploads/*
    handle @api {
        reverse_proxy api:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# === Domeniu principal (default site) ===

manelecadou.ro, www.manelecadou.ro {
    import security_headers
    import api_routes

    handle {
        reverse_proxy web:1500 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

# === Admin app ===

admin.manelecadou.ro {
    import security_headers
    import api_routes

    handle {
        reverse_proxy admin:1505 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

# === Toate celelalte domenii (site-uri multi-tenant) ===
# Match pe orice host, on-demand TLS validează prin /api/internal/caddy/ask

:443 {
    tls {
        on_demand
    }

    import security_headers
    import api_routes

    handle {
        reverse_proxy web:1500 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

# HTTP -> HTTPS redirect global
:80 {
    redir https://{host}{uri} permanent
}
