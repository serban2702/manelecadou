# Caddyfile pentru deploy multi-site cu auto-management de domenii
# API este expus same-origin pe /api/* (NestJS folosește setGlobalPrefix('api'))
# Vezi MULTISITE_DEPLOY.md pentru context.

{
    email admin@manelecadou.ro

    on_demand_tls {
        ask http://api:3000/api/internal/caddy/ask
    }

    storage file_system /data/caddy
}

# === Snippet-uri reutilizabile ===

(api_routes) {
    @api path /api/* /socket.io/* /health /uploads/*
    handle @api {
        reverse_proxy api:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        # X-Frame-Options eliminat (deprecated). frame-ancestors permite
        # player-ul OpenReplay (https://openreplay.manelecadou.ro) să randeze
        # site-ul în iframe pentru replay vizual fidel. Vezi CLAUDE.md §15.
        Content-Security-Policy "frame-ancestors 'self' https://openreplay.manelecadou.ro"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}


(static_assets_cors) {
    @static_assets path /_next/static/* /uploads/* /favicon* /icon* /apple-touch-icon* /site.webmanifest
    header @static_assets {
        # CORS permisiv pentru assets publice — player-ul OpenReplay (pe
        # openreplay.manelecadou.ro) refetch CSS/JS/imagini ca să randeze
        # pagina fidel. Toate astea sunt assets publice oricum.
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        Cross-Origin-Resource-Policy "cross-origin"
    }
}

# === Domeniu principal (default site) ===

manelecadou.ro, www.manelecadou.ro {
    import security_headers
    import api_routes
    import static_assets_cors

    handle {
        reverse_proxy web:1500 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

# === Admin app ===

admin.manelecadou.ro {
    import security_headers
    import api_routes

    # Terminal ops (Claude Code) — ttyd în containerul `ops`. Autentificarea o
    # face ttyd însuși (Basic Auth, OPS_TERMINAL_CREDENTIAL din .env); Caddy doar
    # proxy-ează, inclusiv WebSocket-ul. Vezi CLAUDE.md §17.
    @ops path /ops /ops/*
    handle @ops {
        reverse_proxy ops:7681
    }

    # Chat mode (bridge SSE → claude -p în containerul ops). Auth: JWT admin
    # verificat de bridge. flush_interval -1 = streaming fără buffering.
    @opschat path /ops-chat /ops-chat/*
    handle @opschat {
        reverse_proxy ops:7682 {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy admin:1505 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

# === Toate celelalte domenii (site-uri multi-tenant) ===
# Match pe orice host, on-demand TLS validează prin /api/internal/caddy/ask

:443 {
    tls {
        on_demand
    }

    import security_headers
    import api_routes
    import static_assets_cors

    handle {
        reverse_proxy web:1500 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}

# HTTP -> HTTPS redirect global
:80 {
    redir https://{host}{uri} permanent
}
