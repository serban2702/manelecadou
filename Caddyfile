# Caddyfile pentru deploy multi-site cu auto-management de domenii
# Vezi MULTISITE_DEPLOY.md pentru explicații complete

{
    email admin@manelecadou.ro

    on_demand_tls {
        ask http://api:3000/api/internal/caddy/ask
        interval 2m
        burst    5
    }

    storage file_system /data/caddy
}

# === Domenii fixe (admin + API) ===

admin.manelecadou.ro {
    reverse_proxy admin:1505
}

api.manelecadou.ro {
    reverse_proxy api:3000
}

# === Toate celelalte domenii (site-urile publice) ===
# Match pe orice host, on-demand TLS validează prin /api/internal/caddy/ask

:443 {
    tls {
        on_demand
    }

    header {
        # Securitate de bază
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Forwardează Host original către Next.js → web app îl folosește
    # ca să rezolve site-ul corect prin SitesService.resolveFromHost
    reverse_proxy web:1500 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}

# HTTP -> HTTPS redirect global
:80 {
    redir https://{host}{uri} permanent
}
