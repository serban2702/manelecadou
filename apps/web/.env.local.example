NEXT_PUBLIC_API_URL=http://localhost:1501

# i18n — limba activă pentru acest deploy.
# Una din: ro, bg, sr, tr, el, hr, sl, bs
NEXT_PUBLIC_DEFAULT_LOCALE=ro

# Switcher de limbă în header.
# `true` în dezvoltare/staging (testare).
# `false` în producție per țară (un singur deploy = o singură limbă).
NEXT_PUBLIC_SHOW_LANG_SWITCHER=true

# OpenReplay self-hosted — tracking de sesiuni full-fidelity.
# Lăsate goale = tracker no-op (cazul dev local și înainte ca instance-ul prod
# să fie ridicat). PROJECT_KEY se obține din dashboard-ul OpenReplay la
# Preferences → Projects, după ce e-ul accesibil.
NEXT_PUBLIC_OPENREPLAY_PROJECT_KEY=
NEXT_PUBLIC_OPENREPLAY_INGEST_POINT=https://openreplay.manelecadou.ro/ingest
