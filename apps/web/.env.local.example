NEXT_PUBLIC_API_URL=http://localhost:1501

# i18n — limba activă pentru acest deploy.
# Una din: ro, bg, sr, tr, el, hr, sl, bs
NEXT_PUBLIC_DEFAULT_LOCALE=ro

# Switcher de limbă în header.
# `true` în dezvoltare/staging (testare).
# `false` în producție per țară (un singur deploy = o singură limbă).
NEXT_PUBLIC_SHOW_LANG_SWITCHER=true
